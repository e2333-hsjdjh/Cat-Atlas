[Unit]
Description=Cat Atlas Next.js frontend
After=network.target cat-atlas-api.service

[Service]
Type=simple
User=cat-atlas
Group=cat-atlas
WorkingDirectory=/srv/cat-atlas/current
EnvironmentFile=/etc/cat-atlas/web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm start -- -H 127.0.0.1 -p 3180
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
