[Unit]
Description=Cat Atlas Django API and admin
After=network.target

[Service]
Type=simple
User=cat-atlas
Group=cat-atlas
WorkingDirectory=/srv/cat-atlas/current/backend
EnvironmentFile=/etc/cat-atlas/api.env
ExecStart=/srv/cat-atlas/current/backend/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:3181 --timeout 60 cat_backend.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
