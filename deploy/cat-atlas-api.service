[Unit]
Description=Cat Atlas Django API and admin
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/www/wwwroot/cat-atlas/backend
EnvironmentFile=/www/wwwroot/cat-atlas/backend/.env
ExecStart=/www/wwwroot/cat-atlas/backend/.venv/bin/gunicorn --workers 2 --bind 127.0.0.1:3181 --timeout 60 cat_backend.wsgi:application
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
